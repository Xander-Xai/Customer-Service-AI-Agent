[run]
source =
    agents
    alerts
    api
    auth
    cache
    collaboration
    core
    db
    erp
    knowledge
    llm
    media
    rag
    router
    tools
omit =
    tests/*
    .venv/*
    venv/*
    */__pycache__/*
    */conftest.py
    web/*
    docs/*
    scripts/*
    deploy/*
    monitoring/*
    nginx/*
    loki/*
    data/*
    htmlcov/*
    node_modules/*
    alembic/*
    *erp/kingdee_real_adapter.py

[report]
fail_under = 80
show_missing = true
omit =
    *erp/kingdee_real_adapter.py
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
