# 多智能体客服系统 v3.9 生产环境配置
# 复制此文件为 .env 并根据需要修改

# ===== 硅基流动API配置 =====
OPENAI_API_KEY=your_siliconflow_api_key_here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-8B

# ===== HTTP请求配置 =====
HTTP_TIMEOUT=30

# ===== 路由配置 =====
# 复杂度阈值：<50 走快速通道(sequential)，>=50 走专家通道(协作模式)
ROUTING_COMPLEXITY_THRESHOLD=50

# ===== 响应时长 SLA 配置 =====
RESPONSE_TIME_TARGET_MIN=5.0
RESPONSE_TIME_TARGET_MAX=20.0

# ===== SLA 告警配置 =====
SLA_ALERT_WINDOW=50
SLA_ALERT_THRESHOLD=30.0
SLA_ALERT_COOLDOWN=300

# ===== 模型熔断器配置 =====
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=60
LLM_ROUTER_TIMEOUT=8.0

# ===== 缓存配置 =====
CACHE_L1_MAX=500
CACHE_L2_MAX=2000
CACHE_TTL=3600
CACHE_SEMANTIC_THRESHOLD_SHORT=0.7
CACHE_SEMANTIC_THRESHOLD_LONG=0.5

# ===== 会话配置 =====
SESSION_WINDOW_SIZE=10
SESSION_STORAGE_BACKEND=memory
SESSION_MAX_TOKENS=4000
SESSION_SUMMARY_MAX_CHARS=500

# ===== 漂移检测配置 =====
DRIFT_TOPIC_JACCARD_THRESHOLD=0.15
DRIFT_REPETITION_THRESHOLD=0.8
DRIFT_ESCALATION_THRESHOLD=5

# ===== 连接池配置 =====
HTTPX_MAX_CONNECTIONS=100
HTTPX_KEEPALIVE_CONNECTIONS=20

# ===== 重试配置 =====
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

# ===== 日志配置（v3.9 生产就绪）=====
LOG_LEVEL=INFO
LOG_DIR=logs                           # 日志目录（Docker 内为 /app/logs）
LOG_FORMAT=text                        # text（开发友好）| json（生产结构化）

# ===== CORS 配置（v3.9: 双变量兼容）=====
# CORS_ORIGINS: 旧变量，逗号分隔
CORS_ORIGINS=http://localhost:8000
# ALLOWED_ORIGINS: 新变量，支持逗号分隔或 JSON 数组格式
# 生产环境必须配置为真实域名，例如：
#   ALLOWED_ORIGINS=https://chat.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:8000

# ===== API 认证配置 =====
API_KEY_ENABLED=true
API_KEY=your-secure-api-key-here

# ===== v3.7: 安全加固配置（生产必改）=====
# 监控端点管理 Token（/api/metrics, /api/kpi 等敏感端点需要此 Token）
MONITORING_ADMIN_TOKEN=your-admin-token-here
# WebSocket 连接限制
WS_MAX_CONNECTIONS_PER_IP=5
WS_MESSAGE_RATE_LIMIT=10
WS_IDLE_TIMEOUT=300
# 会话令牌签名密钥（防会话劫持，生产环境务必更换）
SESSION_TOKEN_SECRET=your-session-token-secret-here
# TLS 配置（可选，Nginx 终止 TLS 时不需要）
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CERT_DIR=/dev/null

# ===== ERP 配置 =====
# mock（模拟数据）| real（真实金蝶 API）
ERP_MODE=mock
# real 模式必填以下配置：
ERP_BASE_URL=https://your-kingdee-server.com
ERP_APP_ID=your_app_id
ERP_APP_SECRET=your_app_secret
ERP_DB_ID=your_db_id

# ===== Redis 配置（v3.9: 生产必填）=====
# Docker 内部通信: redis://redis:6379
# 本地开发: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ===== RAG 配置（v3.5）=====
RAG_PERSIST_DIRECTORY=                  # ChromaDB 持久化目录（空则内存模式）
RAG_N_RESULTS=3

# ===== Function Calling 配置（v3.5）=====
TOOL_MAX_ROUNDS=3

# ===== ReAct 配置（v3.5）=====
REACT_MAX_ITERATIONS=5
REACT_COMPLEXITY_THRESHOLD=60

# ===== 安全配置 =====
MAX_QUERY_LENGTH=2000
MAX_SESSIONS=10000
SESSION_IDLE_TTL=3600

# ===== Docker Compose 端口配置（v3.9）=====
APP_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# ===== Gunicorn 配置（v3.9: 生产多 Worker）=====
GUNICORN_WORKERS=2                      # 建议: CPU核心数 × 2 + 1
GUNICORN_BIND=0.0.0.0:8000
