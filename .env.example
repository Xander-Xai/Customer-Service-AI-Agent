# 多智能体客服系统 runtime v6.3 配置模板（审计日期 2026-09-29）
# 复制此文件为 .env 并根据需要修改

# ===== LLM 配置（v4.1: 默认硅基流动）=====
# siliconflow | deepseek | openai | custom
LLM_PROVIDER=siliconflow
OPENAI_API_KEY=your_siliconflow_api_key_here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-8B

# ===== LLM 输出限制 =====
# Recommended deployment value; runtime fallback in core/config.py is 4096.
LLM_MAX_TOKENS=8192

# ===== HTTP请求配置 =====
# Recommended deployment value; runtime fallback in core/config.py is 15.
HTTP_TIMEOUT=30

# ===== 路由配置 =====
# 复杂度阈值：<50 走快速通道(sequential)，>=50 走专家通道(协作模式)
ROUTING_COMPLEXITY_THRESHOLD=50

# ===== 响应时长 SLA 配置 =====
RESPONSE_TIME_TARGET_MIN=5.0
RESPONSE_TIME_TARGET_MAX=20.0

# ===== SLA 告警配置 =====
SLA_ALERT_WINDOW=50
SLA_ALERT_THRESHOLD=30.0
SLA_ALERT_COOLDOWN=300

# ===== 模型熔断器配置 =====
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=60
# Recommended deployment value; runtime fallback in core/config.py is 4.0.
LLM_ROUTER_TIMEOUT=8.0

# ===== 缓存配置 =====
# 注意：CACHE_L1_MAX / CACHE_L2_MAX 已废弃（v6.2）
# L1 Redis 缓存容量由 Redis maxmemory 控制
# L2 Qdrant 向量缓存容量由 Qdrant 集合配置控制
CACHE_TTL=3600
CACHE_SEMANTIC_THRESHOLD_SHORT=0.7
CACHE_SEMANTIC_THRESHOLD_LONG=0.5
# P0-02: 缓存内容版本。知识库/提示词/产品目录大规模变更后提升，即可整体失效三层旧缓存
# （版本不匹配的旧条目不再被命中）。提升后命中率会短暂下降，属预期行为。
CACHE_CONTENT_VERSION=1

# ===== Tool Result Context Engineering =====
# 默认全部关闭；可逐项回滚为 false。优化只改变传给模型的上下文，不能证明 provider
# billing/token cost 已下降。offload/store 需要 Redis（或当前 ToolResultStore 实现的等价后端）。
# scope 必须由服务端可信身份/资源范围提供，禁止使用用户输入或模型自声明身份。
TOOL_RESULT_OPTIMIZATION_ENABLED=false   # deterministic compression/budget gate
TOOL_RESULT_MAX_TOKENS=800                # 估算 token 上限
TOOL_RESULT_MAX_ITEMS=5                   # 结果集合保留上限
TOOL_RESULT_PRESERVE_RECENT=2             # 历史 observation 保留数
TOOL_RESULT_OFFLOAD_ENABLED=false         # 大结果 external store/offload
TOOL_RESULT_OFFLOAD_MIN_TOKENS=1200       # 触发 offload 的估算阈值
TOOL_RESULT_STORE_TTL_SECONDS=900         # external reference TTL
TOOL_RESULT_SEMANTIC_SUMMARY_ENABLED=false # 可选 provider summary，默认关闭
TOOL_RESULT_CACHE_ENABLED=false           # exact scoped reuse；默认关闭，避免读写副作用

# ===== 会话配置 =====
SESSION_WINDOW_SIZE=10
SESSION_STORAGE_BACKEND=memory
SESSION_MAX_TOKENS=4000
SESSION_SUMMARY_MAX_CHARS=500

# ===== 漂移检测配置 =====
DRIFT_TOPIC_JACCARD_THRESHOLD=0.15
DRIFT_REPETITION_THRESHOLD=0.8
DRIFT_ESCALATION_THRESHOLD=5

# ===== 连接池配置 =====
HTTPX_MAX_CONNECTIONS=100
HTTPX_KEEPALIVE_CONNECTIONS=20

# ===== 重试配置 =====
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

# ===== 日志配置（v3.9 生产就绪）=====
LOG_LEVEL=INFO
LOG_DIR=logs                           # 日志目录（Docker 内为 /app/logs）
LOG_FORMAT=text                        # text（开发友好）| json（生产结构化）

# ===== CORS 配置（v3.9: 双变量兼容）=====
# CORS_ORIGINS: 旧变量，逗号分隔
CORS_ORIGINS=http://localhost:8000
# ALLOWED_ORIGINS: 新变量，支持逗号分隔或 JSON 数组格式
# 生产环境必须配置为真实域名，例如：
#   ALLOWED_ORIGINS=https://chat.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:8000

# ===== API 认证配置 =====
API_KEY_ENABLED=true
API_KEY=your-secure-api-key-here

# ===== v3.7: 安全加固配置（生产必改）=====
# 监控端点管理 Token（/api/metrics, /api/kpi 等敏感端点需要此 Token）
MONITORING_ADMIN_TOKEN=your-admin-token-here
# WebSocket 连接限制
WS_MAX_CONNECTIONS_PER_IP=5
WS_MESSAGE_RATE_LIMIT=10
WS_IDLE_TIMEOUT=300
# 会话令牌签名密钥（防会话劫持，生产环境务必更换）
SESSION_TOKEN_SECRET=your-session-token-secret-here
# TLS 配置（可选，Nginx 终止 TLS 时不需要）
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CERT_DIR=/dev/null

# ===== ERP 配置 =====
# mock（模拟数据）| real（真实金蝶 API）
ERP_MODE=mock
# real 模式必填以下配置：
ERP_BASE_URL=https://your-kingdee-server.com
ERP_APP_ID=your_app_id
ERP_APP_SECRET=your_app_secret
ERP_DB_ID=your_db_id

# ===== Redis 配置（v3.9: 生产必填）=====
# Docker 内部通信: redis://:${REDIS_PASSWORD}@redis:6379
# 本地开发: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# ===== RAG 配置（v3.5）=====
RAG_PERSIST_DIRECTORY=                  # Qdrant 持久化目录（空则内存模式，仅用于种子数据控制）
RAG_N_RESULTS=3

# ===== Embedding API 配置（v6.2, 替代本地 sentence-transformers）=====
# 独立 Embedding 服务，不配置时自动回退使用 OPENAI_API_KEY
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=                      # 单独配置后不再复用 LLM 的 API Key
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 必须与 EMBEDDING_MODEL 输出维度一致（bge-large-zh-v1.5 = 1024），runtime fallback 同为 1024
EMBEDDING_DIM=1024

# ===== Reranker API 配置（v6.2）=====
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 混合检索 / 向量库（当前实现，ADR-008）=====
HYBRID_SEARCH_ENABLED=true              # 向量 + BM25 双通道；false 回退纯向量检索
VECTOR_DB_MODE=qdrant_only              # 当前唯一有效值（ChromaDB 已移除）
QDRANT_HOST=localhost                   # Docker Compose 内为 qdrant
QDRANT_PORT=6333

# ===== Function Calling 配置（v3.5）=====
TOOL_MAX_ROUNDS=3

# ===== ReAct 配置（v3.5）=====
REACT_MAX_ITERATIONS=3                     # 与 core/config.py 默认值一致；可按环境显式 override

# ===== v4.0: 用户认证配置 =====
JWT_SECRET=your-jwt-secret-here           # JWT 签名密钥（生产必改）
JWT_EXPIRE_HOURS=72                        # JWT token 有效期（小时）

# ===== v4.0: 数据库配置 =====
DB_DIR=data                                # SQLite 数据库目录
DB_PATH=data/csai.db                       # 数据库文件路径

# ===== v4.0: 告警通知配置 =====
# Webhook 配置（JSON 数组格式）
# 示例: ALERT_WEBHOOKS=[{"name":"钉钉","url":"https://oapi.dingtalk.com/robot/send?access_token=xxx","type":"dingtalk"}]
ALERT_WEBHOOKS=
# SMTP 邮件配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
REACT_COMPLEXITY_THRESHOLD=60

# ===== 安全配置 =====
MAX_QUERY_LENGTH=2000
MAX_SESSIONS=10000
SESSION_IDLE_TTL=3600

# ===== Docker Compose 端口配置（v3.9）=====
APP_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=your_grafana_password_here

# ===== Gunicorn 配置（v3.9: 生产多 Worker）=====
GUNICORN_WORKERS=2                      # 建议: CPU核心数 × 2 + 1
GUNICORN_BIND=0.0.0.0:8000

# ===== v4.1: 数据库配置 =====
# 为空使用 SQLite；生产建议: postgresql://csai:password@postgres:5432/csai
DATABASE_URL=
ALEMBIC_CONFIG_PATH=alembic.ini

# ===== LangGraph Checkpoint 持久化 =====
# memory   = MemorySaver（进程内，仅开发/测试；多 worker/副本不共享，重启丢失）
# postgres = 官方 langgraph-checkpoint-postgres（跨进程/重启持久化，生产必须）
# 留空 = 自动：开发/测试 memory，生产 postgres（推荐；生产显式 postgres 亦可）
LANGGRAPH_CHECKPOINT_BACKEND=
# 留空时安全复用 DATABASE_URL（仅 postgres 协议；不接受 SQLite，不做字符串乱替换）
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=10
LANGGRAPH_CHECKPOINT_SETUP_TIMEOUT=15.0

# ===== 分布式 Agent Runtime（异步 Run + Celery Worker）=====
# celery = 生产路径（API 只入队，Celery worker 执行，进程解耦）
# inline = 开发/测试 fallback（在 API 进程内执行，失去解耦，不用于生产）
AGENT_RUN_DISPATCH=celery
AGENT_RUN_QUEUE=agent_runs
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_RUN_TASK_SOFT_TIME_LIMIT=120
AGENT_RUN_TASK_TIME_LIMIT=180
# thread 串行执行锁：redis（生产，跨 worker/副本）| memory（开发，仅单进程）
AGENT_RUN_THREAD_LOCK_ENABLED=true
AGENT_RUN_THREAD_LOCK_BACKEND=redis
AGENT_RUN_THREAD_LOCK_TTL_SECONDS=300
AGENT_RUN_THREAD_LOCK_RETRY_DELAY_SECONDS=5
# worker ownership lease / heartbeat
AGENT_RUN_LEASE_SECONDS=180
AGENT_RUN_HEARTBEAT_SECONDS=30
# 重试退避（指数 + jitter，受 AGENT_RUN_MAX_ATTEMPTS 硬上限约束）
AGENT_RUN_RETRY_BASE_DELAY=2
AGENT_RUN_RETRY_MAX_DELAY=60
AGENT_RUN_RETRY_JITTER=0.3

# ===== 跨进程 Agent 事件流（Worker -> Redis Stream -> API SSE）=====
# Redis Stream 是临时流式通道；AgentRun(PostgreSQL) 才是真相源。
RUN_EVENT_STREAM_ENABLED=true
RUN_EVENT_STREAM_BACKEND=redis
RUN_EVENT_STREAM_MAXLEN=1000          # XADD MAXLEN ~（防止无限增长）
RUN_EVENT_STREAM_TTL_SECONDS=3600     # EXPIRE
RUN_EVENT_MAX_BYTES=16384             # 单事件大小上限
RUN_EVENT_SSE_BLOCK_MS=15000          # XREAD BLOCK
RUN_EVENT_SSE_COUNT=100
RUN_EVENT_SSE_IDLE_TIMEOUT_SECONDS=300
RUN_EVENT_SSE_POLL_DB_SECONDS=5

# ===== MCP（Model Context Protocol）外部工具适配 =====
# 与 native Function Calling 并存：MCP 是标准化外部工具接口，不是替代品。
# 默认关闭（fail closed）；开启后只允许 MCP_SERVERS allowlist 中的 server/tool。
MCP_ENABLED=false
# JSON 数组；示例（只读工具）：
# MCP_SERVERS=[{"name":"catalog","transport":"stdio","command":"python3","args":["mcp_server.py"],"allowed_tools":["get_product_info","query_order_status"],"timeout_seconds":15,"max_payload_bytes":32768,"risk_level":"read","enabled":true}]
MCP_SERVERS=
MCP_DEFAULT_TIMEOUT_SECONDS=15
MCP_MAX_PAYLOAD_BYTES=32768
# 初始化失败：false=降级为仅 native 工具（默认）；true=启动失败
MCP_FAIL_CLOSED=false

# ===== Human-in-the-loop（高风险操作人工审批）=====
# 只对 HIGH 风险 Tool（退款/改单/高额赔付/投诉升级/ERP 写操作）拦截审批；
# 普通问答不审批。审批记录 durable，approve 后仍经 Tool idempotency 防重复执行。
HITL_ENABLED=true
HITL_HIGH_RISK_TOOLS=refund,create_refund,modify_order,update_order,cancel_order,compensate,refund_order
HITL_MEDIUM_RISK_TOOLS=create_after_sales_ticket,create_ticket,create_complaint,escalate_complaint
HITL_HIGH_AMOUNT_THRESHOLD=1000
HITL_APPROVAL_TTL_SECONDS=604800
# broker 默认复用 REDIS_URL；result backend 留空表示不落结果（真相源是 agent_runs 表）
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===== P0-5: PostgreSQL 配置（Docker Compose 使用）=====
POSTGRES_USER=csai
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=csai

# ===== v4.1: SSE 流式输出 =====
SSE_ENABLED=true                        # 流式输出开关
SSE_CHUNK_SIZE=50                       # 每次发送的字符数

# ===== v4.1: Redis 用途扩展 =====
REDIS_JWT_PREFIX=csai:jwt:blacklist:    # JWT 黑名单前缀
REDIS_RATE_PREFIX=csai:rate:            # 限流计数器前缀
REDIS_SESSION_PREFIX=csai:session:      # 会话存储前缀

# ===== v4.1: A/B 测试 =====
AB_TEST_ENABLED=false

# ===== v4.1: 多模态图片识别 =====
MULTIMODAL_ENABLED=false
MAX_IMAGE_SIZE_MB=5

# ===== P2-1: OpenTelemetry 分布式追踪（可选）=====
OPENTELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=csai-customer-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ===== P2-3: Refresh Token 配置 =====
JWT_ACCESS_EXPIRE_HOURS=2       # access_token 有效期（小时）
JWT_REFRESH_EXPIRE_HOURS=168    # refresh_token 有效期（小时，默认 7 天）
