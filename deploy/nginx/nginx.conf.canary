# ===== 灰度（canary）反向代理配置 =====
#
# 只在 canary stack 生效：`docker compose -f docker-compose.yml \
#   -f docker-compose.prod.yml -f docker-compose.canary.yml` 会把本文件挂载到
# /etc/nginx/conf.d/default.conf，**替换**镜像里 base 的那份。
# base stack（make prod）不会挂载本文件，因此看不到 canary_backend ——
# 那正是 #59 要保证的：base 环境里不存在名为 canary 的 service，
# 引用它会让 nginx 以 "host not found in upstream" 拒绝启动。
#
# 挂载目标必须是 /etc/nginx/conf.d/default.conf（镜像里 server 配置所在处），
# 不是 /etc/nginx/nginx.conf（那是主配置，含 user/events/http，挂一个
# 只有 server{} 的文件进去会让 nginx 报 "server directive is not allowed here"）。
#
# 顶层上下文是 **http**，所以 upstream / map 必须写在 server{} 之外。

# 稳定后端：ip_hash 保证同一客户端 IP 的 WebSocket 会话粘性
upstream stable_backend {
    ip_hash;
    server app:8000;
}

# 灰度后端：canary 服务由 docker-compose.canary.yml 定义，
# 与 stable 共用 cs-network，故可用服务名解析。
upstream canary_backend {
    ip_hash;
    server canary:8000;
}

# 灰度发布：基于 cookie 的流量分割。
# 带 canary_token=canary 的客户端 → 灰度后端；其余 → 稳定后端。
# 说明：这里**没有**"随机 10%"分支——未带 cookie 的一律走 stable。
map $cookie_canary_token $app_backend {
    "canary" canary_backend;
    default  stable_backend;
}

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # TLS 证书（由运维挂载到 /etc/nginx/ssl，见 deploy/compose）
    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # TLS 安全配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 安全头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ws: wss:;" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 默认字符集
    charset utf-8;

    # Gzip 压缩
    gzip on;
    gzip_types text/plain application/json application/javascript text/css;
    gzip_min_length 1000;

    # 最大上传大小（用于 feedback 等 POST 请求）
    client_max_body_size 1m;

    # ===== 主应用路由（cookie 灰度分割）=====
    location / {
        proxy_pass http://$app_backend;

        proxy_http_version 1.1;

        # WebSocket 支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 转发真实客户端 IP
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 灰度标识头（传递给后端）
        proxy_set_header X-Canary-Version $cookie_canary_token;

        # 超时配置（WebSocket 长连接需要更长超时）
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ===== 健康检查（不走认证，直接到 stable）=====
    # 刻意不走灰度后端：稳定后端不可用时应如实反映，而不是被灰度掩盖。
    location = /api/health {
        proxy_pass http://stable_backend/api/health;
        access_log off;
    }

    # ===== 灰度状态端点 =====
    location = /api/canary {
        # 仅允许内网访问
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;

        default_type application/json;
        return 200 '{"canary": "enabled", "cookie": "$cookie_canary_token"}';
    }
}

# 静态资源同样不由 nginx 提供：base 的 nginx.conf 里已说明原因
# （alias 目标路径不存在、Vite 产物是未提交的构建产物），
# 请求落到 location / 由 app 提供。