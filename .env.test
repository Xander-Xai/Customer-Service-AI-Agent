# ===== 本地开发环境配置 =====
# 用法: cp .env.dev .env && make dev
# 或:   docker compose up app

# ===== LLM 配置（v4.1: 硅基流动）=====
LLM_PROVIDER=siliconflow
OPENAI_API_KEY=sk-placeholder-test-key-do-not-use
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-8B
LLM_MAX_TOKENS=8192
HTTP_TIMEOUT=15

# ===== Embedding & Reranker API 配置（v6.2: 测试环境使用 placeholder）=====
# issue #52：默认测试 lane 必须是**离线**的。
#
# 下面的 BASE_URL / API_KEY 保留原样，但 `*_PROVIDER=local` 才是真正生效的闸门：
# provider=local 时走 rag/local_provider.py 的进程内确定性实现，**根本不构造 HTTP
# 客户端**，因此既不需要出网也不需要真实凭据。凭据那两行现在只是"万一有人把
# provider 切回 remote 时不要意外用上真凭据"的保险 —— 它们是占位值，且
# core.config.is_placeholder_api_key() 会把占位值判为不可出网。
#
# 要验证真实 provider 走显式 opt-in lane：make test-real-providers
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=sk-placeholder-embedding-test-key
EMBEDDING_DIM=1024
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=sk-placeholder-reranker-test-key

# ===== 路由配置 =====
ROUTING_COMPLEXITY_THRESHOLD=50

# ===== 缓存配置（内存模式，开发足够）=====
CACHE_L1_MAX=100
CACHE_L2_MAX=500
CACHE_TTL=1800
CACHE_SEMANTIC_THRESHOLD_SHORT=0.7
CACHE_SEMANTIC_THRESHOLD_LONG=0.5

# ===== 会话配置 =====
SESSION_WINDOW_SIZE=10
SESSION_STORAGE_BACKEND=memory
SESSION_MAX_TOKENS=4000
SESSION_SUMMARY_MAX_CHARS=500

# ===== 漂移检测 =====
DRIFT_TOPIC_JACCARD_THRESHOLD=0.15
DRIFT_REPETITION_THRESHOLD=0.8
DRIFT_ESCALATION_THRESHOLD=5

# ===== 连接池 =====
HTTPX_MAX_CONNECTIONS=20
HTTPX_KEEPALIVE_CONNECTIONS=5

# ===== 响应 SLA =====
RESPONSE_TIME_TARGET_MIN=5.0
RESPONSE_TIME_TARGET_MAX=30.0
SLA_ALERT_WINDOW=50
SLA_ALERT_THRESHOLD=30.0
SLA_ALERT_COOLDOWN=300

# ===== 熔断器 =====
CIRCUIT_BREAKER_FAIL_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=30
LLM_ROUTER_TIMEOUT=15.0

# ===== 重试 =====
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY=0.5

# ===== 安全配置（开发宽松模式）=====
API_KEY_ENABLED=false
MONITORING_ADMIN_TOKEN=dev-admin-token
MAX_QUERY_LENGTH=5000
MAX_SESSIONS=1000
SESSION_IDLE_TTL=7200
WS_MAX_CONNECTIONS_PER_IP=20
WS_MESSAGE_RATE_LIMIT=50
WS_IDLE_TIMEOUT=600
SESSION_TOKEN_SECRET=dev-session-secret-do-not-use-in-prod

# ===== 开发模式标识 =====
DEV_MODE=true

# ===== 日志（开发友好）=====
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_FORMAT=text

# ===== CORS（开发环境允许 localhost）=====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ===== ERP（模拟模式）=====
ERP_MODE=mock
ERP_BASE_URL=
ERP_APP_ID=
ERP_APP_SECRET=
ERP_DB_ID=

# ===== Redis =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change_me_in_production

# ===== RAG（内存模式）=====
RAG_PERSIST_DIRECTORY=
RAG_N_RESULTS=3

# ===== v6.2: Qdrant 向量数据库 =====
VECTOR_DB_MODE=qdrant_only
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== Function Calling / ReAct =====
TOOL_MAX_ROUNDS=3
REACT_MAX_ITERATIONS=3
REACT_COMPLEXITY_THRESHOLD=60

# ===== 用户认证 =====
JWT_SECRET=dev-jwt-secret-do-not-use-in-prod
JWT_EXPIRE_HOURS=168

# ===== 数据库 =====
DB_DIR=data
DB_PATH=data/csai.db

# ===== 告警通知（开发环境不配置）=====
ALERT_WEBHOOKS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ===== TLS（开发不启用）=====
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CERT_DIR=/dev/null

# ===== v4.1 新增配置 =====
DATABASE_URL=                                    # 为空使用 SQLite（开发环境）
LANGGRAPH_CHECKPOINT_BACKEND=memory              # 测试使用进程内 MemorySaver
LANGGRAPH_CHECKPOINT_DATABASE_URL=
# ===== v6.4: 分布式 Agent Runtime（测试默认进程内，不触真实 Redis/Celery）=====
# 单元测试注入 RunService/dispatcher/lock；跨进程集成测试用脚本显式覆盖这些值。
AGENT_RUN_DISPATCH=inline
AGENT_RUN_THREAD_LOCK_ENABLED=true
AGENT_RUN_THREAD_LOCK_BACKEND=memory
AGENT_RUN_MAX_ATTEMPTS=3
SSE_ENABLED=true                                 # 流式输出开关
SSE_CHUNK_SIZE=50
ADMIN_PASSWORD=admin123

# ===== 多模态 provider（issue #52）=====
# STT/TTS 与 embedding/reranker 同属"会发起外部请求"的依赖，因此同样有 provider 闸门。
# local 时走进程内确定性替身（media/audio_processor.py、media/tts_processor.py），
# 默认测试 lane 因此不连 Whisper / edge_tts 的公网端点。
STT_PROVIDER=local
TTS_PROVIDER=local
