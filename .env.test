# ===== 测试环境配置 =====
# CI/CD 和本地测试使用，所有外部服务均 mock
# 用法: cp .env.test .env && pytest

# ===== API 配置（测试中 mock，不需要真实 key）=====
OPENAI_API_KEY=test-mock-key
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=test-model
HTTP_TIMEOUT=5

# ===== 路由配置 =====
ROUTING_COMPLEXITY_THRESHOLD=50

# ===== 缓存配置（最小化）=====
CACHE_L1_MAX=10
CACHE_L2_MAX=50
CACHE_TTL=60
CACHE_SEMANTIC_THRESHOLD_SHORT=0.7
CACHE_SEMANTIC_THRESHOLD_LONG=0.5

# ===== 会话配置 =====
SESSION_WINDOW_SIZE=5
SESSION_STORAGE_BACKEND=memory
SESSION_MAX_TOKENS=2000
SESSION_SUMMARY_MAX_CHARS=200

# ===== 漂移检测 =====
DRIFT_TOPIC_JACCARD_THRESHOLD=0.15
DRIFT_REPETITION_THRESHOLD=0.8
DRIFT_ESCALATION_THRESHOLD=5

# ===== 连接池（最小）=====
HTTPX_MAX_CONNECTIONS=5
HTTPX_KEEPALIVE_CONNECTIONS=2

# ===== 响应 SLA =====
RESPONSE_TIME_TARGET_MIN=1.0
RESPONSE_TIME_TARGET_MAX=60.0
SLA_ALERT_WINDOW=10
SLA_ALERT_THRESHOLD=50.0
SLA_ALERT_COOLDOWN=60

# ===== 熔断器 =====
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIME=5
LLM_ROUTER_TIMEOUT=30.0

# ===== 重试 =====
RETRY_MAX_ATTEMPTS=1
RETRY_BASE_DELAY=0.1

# ===== 安全配置（测试关闭认证）=====
API_KEY_ENABLED=false
MONITORING_ADMIN_TOKEN=test-admin-token
MAX_QUERY_LENGTH=10000
MAX_SESSIONS=100
SESSION_IDLE_TTL=300
WS_MAX_CONNECTIONS_PER_IP=50
WS_MESSAGE_RATE_LIMIT=100
WS_IDLE_TIMEOUT=600
SESSION_TOKEN_SECRET=test-session-secret

# ===== 开发模式 =====
DEV_MODE=true

# ===== 日志 =====
LOG_LEVEL=WARNING
LOG_DIR=logs
LOG_FORMAT=text

# ===== CORS（测试允许 localhost）=====
CORS_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ===== ERP（mock 模式）=====
ERP_MODE=mock
ERP_BASE_URL=
ERP_APP_ID=
ERP_APP_SECRET=
ERP_DB_ID=

# ===== Redis（测试不需要真实 Redis）=====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# ===== RAG（内存模式）=====
RAG_PERSIST_DIRECTORY=
RAG_N_RESULTS=1

# ===== Function Calling / ReAct =====
TOOL_MAX_ROUNDS=2
REACT_MAX_ITERATIONS=3
REACT_COMPLEXITY_THRESHOLD=60

# ===== 用户认证 =====
JWT_SECRET=test-jwt-secret
JWT_EXPIRE_HOURS=24

# ===== 数据库（测试用临时文件）=====
DB_DIR=data/test
DB_PATH=data/test/csai_test.db

# ===== 告警（测试不发送）=====
ALERT_WEBHOOKS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ===== TLS =====
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CERT_DIR=/dev/null
